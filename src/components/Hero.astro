---
import type { SupportedLanguage } from '../i18n/translations';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
---

<section id="hero" class="relative min-h-screen flex items-center gradient-primary pt-20 overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-20 left-10 w-72 h-72 bg-white rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-white rounded-full blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 py-16 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="text-primary-foreground">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 mb-8 border border-white/20 shadow-inner">
          <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
          <span class="text-sm md:text-base font-semibold tracking-wide">{t.hero.badge}</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          {t.hero.title1}{' '}
          <span class="text-secondary">{t.hero.title2}</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-xl md:text-2xl text-primary-foreground/90 mb-4 font-medium">
          {t.hero.subheadline}
        </p>

        <!-- Description -->
        <p class="text-base sm:text-lg text-primary-foreground/80 mb-8 max-w-xl leading-relaxed">
          {t.hero.description}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={`https://wa.me/60138799702?text=${encodeURIComponent(t.contact.waMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-white text-primary px-7 py-4 rounded-xl text-base md:text-lg font-bold hover:bg-white/90 transition-all shadow-xl hover:scale-105"
            data-track="cta"
          >
            <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {t.hero.ctaConsultation}
          </a>
          <a
            href="#portfolio"
            class="inline-flex items-center justify-center gap-2 border-2 border-white/40 text-white px-7 py-4 rounded-xl text-base md:text-lg font-semibold hover:bg-white/10 transition-all"
          >
            {t.hero.ctaPortfolio}
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
        </div>

        <!-- Social Proof Pill -->
        <div class="mt-8 flex items-center gap-3 text-sm text-primary-foreground/70">
          <div class="flex -space-x-2">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-secondary/80 text-white text-xs font-bold ring-2 ring-background">Go</span>
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-blue-500 text-white text-xs font-bold ring-2 ring-background">K8s</span>
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-purple-500 text-white text-xs font-bold ring-2 ring-background">AI</span>
          </div>
          <span>{t.hero.socialProof}</span>
        </div>
      </div>

      <!-- Animated Feature Cards -->
      <div class="mt-12 lg:mt-0 relative">
        <div class="space-y-4 sm:space-y-5">
          <!-- Card 1: Conversion-Focused Website -->
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-5 md:p-6 shadow-xl hover:bg-white/15 transition-all border border-white/10">
            <div class="flex items-start gap-4">
              <div class="bg-secondary/20 p-3 rounded-xl flex-shrink-0">
                <svg class="w-7 h-7 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
                </svg>
              </div>
              <div>
                <h3 class="text-white font-bold text-base md:text-lg mb-1">{t.hero.cards[0].title}</h3>
                <p class="text-white/80 text-xs md:text-sm">{t.hero.cards[0].desc}</p>
              </div>
            </div>
          </div>

          <!-- Card 2: Booking & Workflow Automation -->
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-5 md:p-6 shadow-xl hover:bg-white/15 transition-all border border-white/10 sm:ml-8">
            <div class="flex items-start gap-4">
              <div class="bg-white/20 p-3 rounded-xl flex-shrink-0">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <div>
                <h3 class="text-white font-bold text-base md:text-lg mb-1">{t.hero.cards[1].title}</h3>
                <p class="text-white/80 text-xs md:text-sm">{t.hero.cards[1].desc}</p>
              </div>
            </div>
          </div>

          <!-- Card 3: Practical AI Automation -->
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-5 md:p-6 shadow-xl hover:bg-white/15 transition-all border border-white/10">
            <div class="flex items-start gap-4">
              <div class="bg-secondary/20 p-3 rounded-xl flex-shrink-0">
                <svg class="w-7 h-7 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <div>
                <h3 class="text-white font-bold text-base md:text-lg mb-1">{t.hero.cards[2].title}</h3>
                <p class="text-white/80 text-xs md:text-sm">{t.hero.cards[2].desc}</p>
              </div>
            </div>
          </div>

          <!-- Stats Badge -->
          <div class="bg-gradient-to-r from-secondary to-primary rounded-2xl p-5 md:p-6 shadow-2xl border border-white/20">
            <div class="text-center">
              <div class="text-2xl md:text-3xl font-extrabold text-white mb-1">{t.hero.statsBadge.title}</div>
              <p class="text-white/90 text-xs md:text-sm font-medium">{t.hero.statsBadge.desc}</p>
              <div class="flex items-center justify-center gap-2 mt-3 flex-wrap">
                {t.hero.statsBadge.tags.map(tag => (
                  <span class="text-xs px-2.5 py-1 rounded-md bg-white/20 text-white font-semibold">{tag}</span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Floating Decorative Elements -->
        <div class="absolute -top-10 -right-10 w-32 h-32 bg-secondary/30 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-10 -left-10 w-40 h-40 bg-primary/20 rounded-full blur-3xl pointer-events-none"></div>
      </div>
    </div>
  </div>

  <!-- Bottom Wave -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" class="w-full h-auto">
      <path fill="hsl(var(--background))" d="M0,64L60,69.3C120,75,240,85,360,80C480,75,600,53,720,48C840,43,960,53,1080,64C1200,75,1320,85,1380,90L1440,96L1440,120L0,120Z"></path>
    </svg>
  </div>
</section>
