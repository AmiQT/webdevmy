---
import type { SupportedLanguage } from '../i18n/translations';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
---

<section id="portfolio" class="section-padding bg-muted/30">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 md:mb-16">
      <span class="inline-block text-sm font-semibold text-secondary mb-4 tracking-wider uppercase">
        {t.portfolio.tag}
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        {t.portfolio.title}{' '}
        <span class="gradient-text">{t.portfolio.titleHighlight}</span>
      </h2>
      <p class="text-lg text-muted-foreground">
        {t.portfolio.desc}
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {t.portfolio.projects.map((project, index) => (
        <div
          class="group bg-card border border-border rounded-2xl p-6 hover:border-secondary/40 hover:bg-card/80 transition-all duration-300 flex flex-col justify-between shadow-sm hover:shadow-lg"
        >
          <div class="flex flex-col gap-3">
            <!-- Top Row: Category + Index -->
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-secondary tracking-wider uppercase bg-secondary/10 px-2.5 py-1 rounded-md">
                {project.category}
              </span>
              <span class="text-muted-foreground/40 text-xs font-mono font-bold">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-foreground group-hover:text-secondary transition-colors duration-300 leading-snug">
              {project.title}
            </h3>

            <!-- Description -->
            <p class="text-muted-foreground text-sm leading-relaxed">
              {project.description}
            </p>
          </div>

          <!-- Tags -->
          <div class="flex flex-wrap gap-1.5 pt-4 mt-4 border-t border-border">
            {project.tags.map(tag => (
              <span class="text-xs px-2 py-0.5 rounded-md bg-muted text-muted-foreground group-hover:text-secondary/90 transition-colors duration-300 font-medium">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA & Deep-Dive Link -->
    <div class="text-center mt-14 bg-card border border-border rounded-2xl p-8 max-w-2xl mx-auto shadow-sm">
      <h3 class="text-xl font-bold text-foreground mb-2">{t.portfolio.moreCodeTitle}</h3>
      <p class="text-muted-foreground text-sm mb-6">
        {t.portfolio.moreCodeDesc}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://noorazami.me"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-2 border-primary text-primary px-6 py-3 rounded-xl font-semibold hover:bg-primary hover:text-white transition-all w-full sm:w-auto justify-center"
        >
          <span>{t.portfolio.openPortfolio}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <a
          href={`https://wa.me/60138799702?text=${encodeURIComponent(t.portfolio.waMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-6 py-3 rounded-xl font-semibold hover:bg-primary/90 transition-all shadow-md hover:scale-105 w-full sm:w-auto justify-center"
        >
          {t.portfolio.discussProject}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
