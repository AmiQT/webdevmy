---
import type { SupportedLanguage } from '../i18n/translations';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
---

<div 
  id="exitIntentPopup" 
  class="fixed inset-0 z-50 hidden items-center justify-center p-4"
  role="dialog" 
  aria-modal="true" 
  aria-hidden="true"
>
  <!-- Overlay -->
  <div class="absolute inset-0 bg-background/80 backdrop-blur-sm" id="popupOverlay"></div>
  
  <!-- Content -->
  <div class="relative bg-card border border-border rounded-2xl max-w-lg w-full p-6 md:p-8 text-center transform scale-95 opacity-0 transition-all duration-300 shadow-2xl" id="popupContent">
    <!-- Close button -->
    <button 
      class="absolute top-3 right-3 text-muted-foreground hover:text-foreground transition-colors p-1.5 rounded-full hover:bg-muted"
      id="popupClose"
      aria-label="Close popup"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    
    <div class="inline-flex items-center gap-2 bg-secondary/10 text-secondary text-xs font-bold px-3 py-1 rounded-full mb-3 uppercase tracking-wider">
      {t.exitPopup.badge}
    </div>

    <h3 class="text-2xl md:text-3xl font-extrabold text-foreground mb-2">{t.exitPopup.title}</h3>
    <p class="text-muted-foreground mb-5 text-sm md:text-base">
      {t.exitPopup.subtitlePre}<span class="text-primary font-bold">{t.exitPopup.subtitleHighlight}</span>{t.exitPopup.subtitlePost}
    </p>
    
    <!-- Audit Badge -->
    <div class="inline-flex items-center gap-2 bg-gradient-to-r from-primary to-secondary text-white text-lg md:text-xl font-bold px-6 py-2.5 rounded-xl mb-6 shadow-lg">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      {t.exitPopup.freeConsultationBadge}
    </div>
    
    <!-- Benefits list -->
    <ul class="text-left space-y-3 mb-6 bg-muted/40 p-4 rounded-xl border border-border/60">
      {t.exitPopup.benefits.map(benefit => (
        <li class="flex items-center gap-3 text-foreground text-sm font-medium">
          <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>{benefit}</span>
        </li>
      ))}
    </ul>
    
    <!-- CTA Button -->
    <a 
      href={`https://wa.me/60138799702?text=${encodeURIComponent(t.exitPopup.waMessage)}`}
      target="_blank" 
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 w-full bg-secondary hover:bg-secondary/90 text-white font-bold py-3.5 px-6 rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-[1.02]"
      data-track="cta"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      {t.exitPopup.cta}
    </a>
    
    <p class="text-xs text-muted-foreground mt-4">{t.exitPopup.note}</p>
  </div>
</div>

<script>
  const popup = document.getElementById('exitIntentPopup');
  const popupContent = document.getElementById('popupContent');
  const popupClose = document.getElementById('popupClose');
  const popupOverlay = document.getElementById('popupOverlay');
  
  let hasShown = false;
  
  const showPopup = () => {
    if (hasShown) return;
    hasShown = true;
    popup?.classList.remove('hidden');
    popup?.classList.add('flex');
    setTimeout(() => {
      popupContent?.classList.remove('scale-95', 'opacity-0');
      popupContent?.classList.add('scale-100', 'opacity-100');
    }, 10);
  };
  
  const hidePopup = () => {
    popupContent?.classList.add('scale-95', 'opacity-0');
    popupContent?.classList.remove('scale-100', 'opacity-100');
    setTimeout(() => {
      popup?.classList.add('hidden');
      popup?.classList.remove('flex');
    }, 300);
  };
  
  // Exit intent detection
  document.addEventListener('mouseout', (e) => {
    if (e.clientY < 10) showPopup();
  });
  
  popupClose?.addEventListener('click', hidePopup);
  popupOverlay?.addEventListener('click', hidePopup);
  
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hidePopup();
  });
</script>
