---
import type { SupportedLanguage } from '../i18n/translations';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
---

<section class="section-padding bg-background">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block text-sm font-semibold text-secondary mb-4 tracking-wider uppercase">
        {t.benefits.tag}
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
        {t.benefits.title}{' '}
        <span class="text-secondary">{t.benefits.titleHighlight}</span>
      </h2>
      <p class="text-lg text-muted-foreground">
        {t.benefits.desc}
      </p>
    </div>

    <!-- Stats Row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 mb-16">
      {t.benefits.stats.map(stat => (
        <div
          class="text-center p-6 bg-primary/5 border border-primary/10 rounded-2xl transition-all duration-300 hover:border-primary/30 hover:bg-primary/10"
        >
          <div class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-primary mb-2">{stat.value}</div>
          <p class="text-muted-foreground text-xs sm:text-sm font-medium">{stat.label}</p>
        </div>
      ))}
    </div>

    <!-- Benefits & Reasons Grid -->
    <div class="grid lg:grid-cols-2 gap-8">
      <!-- Benefits -->
      <div class="bg-card border border-border rounded-2xl p-6 sm:p-8 shadow-sm">
        <h3 class="text-2xl font-bold mb-8 text-foreground">{t.benefits.benefitsTitle}</h3>
        <div class="space-y-6">
          {t.benefits.items.map(benefit => (
            <div
              class="flex gap-4 transition-colors duration-300"
            >
              <div class="w-12 h-12 rounded-xl bg-secondary/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-lg mb-1 text-foreground">{benefit.title}</h4>
                <p class="text-muted-foreground text-sm leading-relaxed">{benefit.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Why Choose Us -->
      <div class="bg-primary/5 border border-primary/10 rounded-2xl p-6 sm:p-8 flex flex-col justify-between">
        <div>
          <h3 class="text-2xl font-bold mb-8 text-foreground">{t.benefits.whyTitle}</h3>
          <ul class="space-y-4">
            {t.benefits.reasons.map(reason => (
              <li
                class="flex items-start gap-3 text-sm sm:text-base"
              >
                <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span class="text-foreground/90 font-medium">{reason}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-8 pt-6 border-t border-primary/10">
          <p class="text-muted-foreground mb-4 text-sm">{t.benefits.whyCtaDesc}</p>
          <a
            href={`https://wa.me/60138799702?text=${encodeURIComponent(t.benefits.waMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground px-7 py-3.5 rounded-xl font-semibold hover:bg-primary/90 transition-all shadow-md hover:scale-105 w-full sm:w-auto"
          >
            {t.benefits.whyCtaBtn}
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
